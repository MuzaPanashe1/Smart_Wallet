# Server Configuration
PORT=5055
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_secret

# PostgreSQL Database Configuration
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Smart_Wallet
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DATABASE_URL=postgresql://your_database_username:your_database_password@localhost:5432/Smart_Wallet

# Python Fraud Detection Microservice
FRAUD_SERVICE_URL=http://localhost:5001

# Exchange Rate API
EXCHANGE_API_KEY=your_api_key_here

# Payment Simulation
MOCK_PAYMENT_FORCE_FAILURE=false